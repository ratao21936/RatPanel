# ─────────────────────────────────────────────────────────
# RatPanel — .gitignore
# ─────────────────────────────────────────────────────────

# ─── Logs ────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ─── Dependências ────────────────────────────────────────
node_modules/
jspm_packages/
bower_components/
web_modules/
.pnpm-store

# ─── Ambiente / Segredos ─────────────────────────────────
.env
.env.*
!.env.example

# ─── Dados do RatPanel (NÃO subir) ───────────────────────
backend/users.json
backend/webhook.json
backend/processes.json
backend/schedules.json
backend/tags.json
backend/notes.json
backend/groups.json

# ─── Pastas de conteúdo do usuário ───────────────────────
backend/uploads/
backend/bots/

# ─── Build / cache ───────────────────────────────────────
dist
build/
build/Release
.cache
.parcel-cache
.temp
out
.next
.nuxt
.output
.vite/
.svelte-kit/
.serverless/
.dynamodb/
.firebase/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus
.fusebox/
.tern-port

# ─── Caches de ferramentas ───────────────────────────────
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.tsbuildinfo
.grunt
.lock-wscript
.yarn-integrity
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ─── Testes / cobertura ──────────────────────────────────
coverage
*.lcov
.nyc_output
lib-cov
.vscode-test

# ─── Pacotes ─────────────────────────────────────────────
*.tgz

# ─── Sistema operacional ─────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editores / IDEs ────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
